{
  "version": 3,
  "default_scopes": [
    "auth",
    "consent-onboarding",
    "documents",
    "screening",
    "adaptive",
    "analysis",
    "results-report"
  ],
  "scopes": {
    "legacy-journey": {
      "tag": "@legacy-journey",
      "spec": "e2e/legacy-journey.spec.ts",
      "start_checkpoint": "fresh",
      "end_checkpoint": "home_complete",
      "timeout_class": "legacy-journey",
      "real_analysis": true
    },
    "auth": {
      "tag": "@scope-auth",
      "spec": "e2e/scopes/auth.spec.ts",
      "start_checkpoint": "fresh",
      "end_checkpoint": "verified_pending_consent",
      "timeout_class": "short",
      "real_analysis": false
    },
    "consent-onboarding": {
      "tag": "@scope-consent-onboarding",
      "spec": "e2e/scopes/consent-onboarding.spec.ts",
      "start_checkpoint": "verified_pending_consent",
      "end_checkpoint": "records_ready",
      "timeout_class": "short",
      "real_analysis": false
    },
    "onboarding-resume": {
      "tag": "@scope-onboarding-resume",
      "spec": "e2e/scopes/onboarding-resume.spec.ts",
      "start_checkpoint": "onboarding_ready",
      "end_checkpoint": "records_ready",
      "timeout_class": "short",
      "real_analysis": false
    },
    "onboarding-draft-restore": {
      "tag": "@scope-onboarding-draft-restore",
      "spec": "e2e/scopes/onboarding-draft-restore.spec.ts",
      "start_checkpoint": "onboarding_ready",
      "end_checkpoint": "records_ready",
      "timeout_class": "short",
      "real_analysis": false
    },
    "onboarding-intro-idempotence": {
      "tag": "@scope-onboarding-intro-idempotence",
      "spec": "e2e/scopes/onboarding-intro-idempotence.spec.ts",
      "start_checkpoint": "verified_pending_consent",
      "end_checkpoint": "onboarding_ready",
      "timeout_class": "short",
      "real_analysis": false
    },
    "documents": {
      "tag": "@scope-documents",
      "spec": "e2e/scopes/documents.spec.ts",
      "start_checkpoint": "records_ready",
      "end_checkpoint": "screening_ready",
      "timeout_class": "documents",
      "real_analysis": false
    },
    "screening": {
      "tag": "@scope-screening",
      "spec": "e2e/scopes/screening.spec.ts",
      "start_checkpoint": "screening_ready",
      "end_checkpoint": "adaptive_ready",
      "timeout_class": "screening",
      "real_analysis": false
    },
    "adaptive": {
      "tag": "@scope-adaptive",
      "spec": "e2e/scopes/adaptive.spec.ts",
      "start_checkpoint": "adaptive_ready",
      "end_checkpoint": "review_ready",
      "timeout_class": "adaptive",
      "real_analysis": false
    },
    "analysis": {
      "tag": "@scope-analysis",
      "spec": "e2e/scopes/analysis.spec.ts",
      "start_checkpoint": "review_ready",
      "end_checkpoint": "results_ready",
      "timeout_class": "analysis",
      "real_analysis": true
    },
    "results-report": {
      "tag": "@scope-results-report",
      "spec": "e2e/scopes/results-report.spec.ts",
      "start_checkpoint": "results_ready",
      "end_checkpoint": "home_complete",
      "timeout_class": "report",
      "real_analysis": false,
      "fixture": "results-report-v1"
    }
